# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# ── 虚拟环境 ──
.venv/
venv/
env/

# ── 敏感配置（含 API Key、DB 密码）──
.env.local
.env.*.local
.env.production
*.key

# ── 本地模型权重（大文件，不入库）──
backend/models/
*.bin
*.pt
*.safetensors

# ── IDE / 编辑器 ──
.vscode/
.idea/
.jbeval/
*.swp
*.swo
.DS_Store

# ── 日志 / 临时文件 ──
*.log
logs/
tmp/
temp/

# ── 数据库 / 向量库 本地数据 ──
*.db
*.sqlite3
*.milvus

# ── 测试 / 覆盖率 ──
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Jupyter ──
.ipynb_checkpoints/

# ── 前端依赖（体积大，装依赖即可）──
node_modules/

# ── 生成的交付物（简历 docx 等，可由 docs/ 重新生成）──
output/

# ── 本地私有扫描词（公司名/姓名/客户名；不进版本控制）──
.leak-scan-extra
