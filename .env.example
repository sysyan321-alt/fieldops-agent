DB_HOST=localhost
DB_PORT=5433
DB_NAME=fieldops
DB_USER=fieldops_user
DB_PASSWORD=your_password
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
# Qwen（通义千问，DashScope OpenAI 兼容接口，当前默认提供商）
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_CHAT=deepseek-v4.1-flash
DEFAULT_LLM_PROVIDER=qwen
# 联网搜索（可选）：填 Tavily Key 优先用 Tavily，留空自动降级 DuckDuckGo
TAVILY_API_KEY=
JWT_SECRET_KEY=any-random-secret-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
MILVUS_HOST=localhost
MILVUS_PORT=19531
# Redis 缓存（意图识别 + SOP 检索结果；不可用时自动旁路，不影响主链路）
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL_INTENT=600
CACHE_TTL_RETRIEVAL=300
# 会话检查点（LangGraph checkpointer，写进业务库同库的 checkpoints 三张表）
# auto = 连不上库回落内存（本地开发）；postgres = 强制不许回落（生产建议）；memory = 单测/离线
CHECKPOINT_BACKEND=auto
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=10
RERANKER_MODEL_PATH=./models/reranker/bge-reranker-large
BGE_M3_MODEL_PATH=./models/embedding/bge-m3
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default
# ── MCP 能力层（详见 docs/mcp.md）──
# 写工具（/mcp/alert-ops、/mcp/sop-kb-admin）的 Bearer Token；留空则写工具禁用
MCP_ADMIN_TOKEN=
# 写工具允许操作的租户白名单（逗号分隔）
MCP_WRITE_TENANTS=tenant_default
# 是否挂载 MCP Server（/mcp/*）
MCP_ENABLED=true

# ── 安全默认值 ──
# 演示账号播种：**默认关闭**。开源项目不能一启动就带人人皆知的口令。
# 直接体验时置 true（会播种 worker/supervisor/admin 三个演示账号）；
# 生产环境请用 `python scripts/create_user.py --username <你> --role admin` 建管理员。
SEED_DEMO_USERS=false

# CORS：逗号分隔的来源白名单；"*" = 允许任意来源（开发/演示）。
# 留空 = 不启用 CORS（同源部署：Vite 代理 / Nginx 反代都不需要）。
# 注意：allow_origins 含 "*" 时后端会强制关闭凭证（浏览器会拒绝通配 + 凭证的组合）。
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# 登录失败限流（按 用户名+来源IP 计数）
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ── 照护计划数据来源（Provider 抽象）──
# local = 读 care 自己的库（演示/离线）；saas = 读机构 SaaS
CARE_PLAN_PROVIDER=local
SAAS_CARE_BASE_URL=
SAAS_CARE_TOKEN=
